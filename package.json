{
  "name": "book-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An installable mobile reader for EPUB and PDF with a realistic page-flip animation.",
  "scripts": {
    "sync-pdfjs": "node scripts/sync-pdfjs-assets.mjs",
    "predev": "npm run sync-pdfjs",
    "prebuild": "npm run sync-pdfjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
